# Configuração AWS da aplicação (copie para deploy/.env e ajuste se necessário).
# Usado para testar a imagem localmente:
#   docker run --rm -p 8501:8501 --env-file deploy/.env \
#     -v $HOME/.aws:/root/.aws:ro <REPO_NAME>:latest
#
# Em produção (ECS) estes vão no bloco "environment" da task definition.

AWS_REGION=us-east-1
ATHENA_DATABASE=db_spdo_apps
S3_DATA_BASE=s3://ibre-spdo-coleta-bronze/apps/consulta_similaridade
S3_VECTORS_BUCKET=spdo-embeddings
S3_VECTORS_INDEX=insumos-sbert-384

# --- Credenciais ---
# NÃO use chaves no código. Opções:
#  (a) Local: 'aws configure' e monte ~/.aws no container (-v acima); OU
#  (b) descomente e preencha abaixo (apenas para teste local, NÃO comitar):
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
